# Refuse to install any package version published less than 7 days ago.
#
# Supply-chain protection: most malicious package releases are caught and unpublished within
# hours or a couple of days, so a short quarantine avoids the window in which a compromised
# release is most dangerous. Requires npm 12 or later - the workflows install it explicitly
# after actions/setup-node, since the npm bundled with Node 24 is still 11.x.
#
# Practical consequence: an urgent dependency bump cannot land until the new version is 7 days
# old. Override deliberately and temporarily with `npm ci --min-release-age 0` if that is ever
# genuinely needed, rather than removing this line.
min-release-age=7
