# -----------------------------
# Exclude files from releases
# git files
.gitattributes export-ignore
.gitignore export-ignore
.github/* export-ignore

# misc development config files
.vscode export-ignore
snyk.sarif export-ignore
src/__tests__ export-ignore
src/test/* export-ignore
.dockerignore export-ignore
src/.eslintrc.yml export-ignore
src/.jshintrc export-ignore
src/.prettierignore export-ignore
src/.prettierrc.yaml export-ignore
src/.prettierrc export-ignore
src/.snyk export-ignore
src/Dockerfile export-ignore

.jshintrc export-ignore
.release-please-manifest.json export-ignore
release-please-config.json export-ignore

release-config export-ignore
release export-ignore
release-macos export-ignore

# general text files
changelog.md export-ignore

# Screenshots
src/img/** export-ignore
img/** export-ignore


# -----------------------------
# Enforce Unix newlines
* text eol=lf

# -----------------------------
# binaries
*.ai binary
*.psd binary
*.jpg binary
*.gif binary
*.png binary
*.jpeg binary
# Apple's CA certificates in release-config/apple-ca/, which the macOS signing keychain imports. They
# are DER, and `* text eol=lf` above would otherwise treat them as text, normalising any CRLF pair
# in their bytes on commit.
*.cer binary
